# SERVIDOR
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AUTENTICACIÓN
JWT_SECRET=PEGAR_AQUI_SECRET_SEGURO
INITIAL_ADMIN_USERNAME=rojasimpresiones
# Generar con: npm run hash-password -- lavalle37
INITIAL_ADMIN_PASSWORD_HASH=PEGAR_AQUI_HASH_BCRYPT

# GOOGLE SHEETS
GOOGLE_SHEET_ID=PEGAR_AQUI_ID_DE_GOOGLE_SHEET
GOOGLE_SERVICE_ACCOUNT_EMAIL=PEGAR_AQUI_EMAIL_SERVICE_ACCOUNT
GOOGLE_PRIVATE_KEY="PEGAR_AQUI_PRIVATE_KEY"

# OPENAI
OPENAI_API_KEY=PEGAR_AQUI_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
AI_ENABLED=true
AI_MONTHLY_BUDGET_USD=2

# VERCEL BLOB (Vercel la agrega al conectar un Blob privado)
BLOB_READ_WRITE_TOKEN=PEGAR_AQUI_TOKEN_DE_VERCEL_BLOB
# Alternativa moderna con OIDC; normalmente Vercel la configura automáticamente
BLOB_STORE_ID=PEGAR_AQUI_ID_DEL_BLOB_STORE

# DATOS: demo | xlsx | google_sheets
DATA_SOURCE=xlsx
EXCEL_FILE_PATH=C:/RUTA/AL/ARCHIVO.xlsx
